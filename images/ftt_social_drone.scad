module limb(in=[[5,5,20,0,0,0,true],[5,2,20,0,0,0,true]],n=0){
if(in[n][6]){
hull(){
    sphere(in[n][0]);
    rotate([in[n][3],in[n][4],in[n][5]]){
        translate([0,0,in[n][2]]){
            sphere(in[n][1]);
        }
    }
}
}
if(n<len(in)){
    rotate([in[n][3],in[n][4],in[n][5]]){
        translate([0,0,in[n][2]]){
            limb(in,n+1);
        }
    }
}
}

