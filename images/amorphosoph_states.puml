@startuml
skinparam backgroundColor #000

card 1 #4F4
card 2 #4F4

card A #4F4
card B #4F4
card C #4F4

card X #4F4
card Y #4F4
card Z #4F4
card Bs as "Broken state" #F44

1 -[bold]-> 2
2 -[bold]-> 1

A -[bold]-> B
B -[bold]-> C
C -[bold]-> A

X -[bold]-> Y
Y -[bold]-> X
Y -[bold]-> Z
Z -[bold]-> Y
Y -[bold]-> Bs

@enduml

